# Скопируйте в .env и поменяйте значения (файл .env необязателен — без него работают значения по умолчанию)

# --- Деплой (docker-stack.yml) ---
DOMAIN=shpora.example.com
# Префикс образов в ghcr, например ghcr.io/nekotyan2d/spo2 (к нему добавляется -frontend / -backend)
IMAGE_PREFIX=ghcr.io/owner/repo
IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_DB=shpora
POSTGRES_USER=shpora
POSTGRES_PASSWORD=shpora

# --- JWT ---
SECRET_KEY=поменяйте-на-длинную-случайную-строку
# Срок жизни access-токена (минуты) и refresh-токена (дни)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Первый администратор (создаётся при старте, если его ещё нет) ---
ADMIN_EMAIL=admin@shpora.ru
ADMIN_PASSWORD=admin12345
ADMIN_NICKNAME=admin

# --- Прочее ---
# Сколько предупреждений до автоматического бана
WARNINGS_TO_AUTO_BAN=3
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=20
# Разрешённые источники для фронтенда через запятую (* — все)
CORS_ORIGINS=*
# Заполнять ли справочники стартовыми данными при первом запуске
SEED_DEMO_DATA=true
